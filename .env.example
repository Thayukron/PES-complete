# ค่าสำหรับ docker compose (คัดลอกเป็น .env แล้วแก้) — ไม่มีไฟล์นี้ระบบจะใช้ค่าเริ่มต้นสำหรับพัฒนา
DB_ROOT_PASSWORD=rootpassword
# เปลี่ยนเป็นค่าสุ่มยาว ๆ ทุกครั้งที่ใช้งานจริง: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))"
JWT_SECRET=dev-only-secret-change-me-before-production

# พอร์ตบนเครื่อง
WEB_PORT=3000
API_PORT=7000
PMA_PORT=8082
DB_PORT=3308
