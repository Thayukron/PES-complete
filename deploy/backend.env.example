# คัดลอกเป็น deploy/backend.env บนเครื่อง Production แล้วเปลี่ยนรหัสทั้งหมด
PORT=7000
JWT_SECRET=เปลี่ยนเป็นค่าสุ่มยาวอย่างน้อย32ตัวอักษร
JWT_EXPIRES=8h
UPLOAD_MAX_MB=10

# ฐานข้อมูล (ใช้ร่วมกับ container db)
MYSQL_ROOT_PASSWORD=เปลี่ยนรหัสผ่านฐานข้อมูล
DB_USER=root
DB_PASSWORD=เปลี่ยนรหัสผ่านฐานข้อมูล
DB_NAME=skills_db
DB_PORT=3306
