# ===== Backend env (คัดลอกเป็น .env แล้วแก้ค่า) =====
PORT=7000
NODE_ENV=development
# โดเมนหน้าเว็บที่อนุญาต (คั่นด้วย ,) — ถ้าเรียกผ่าน proxy ของ frontend ไม่จำเป็นต้องตั้ง
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Database — รัน backend นอก docker (npm run dev) ต่อ MySQL ของ docker compose ที่ localhost:3308
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=skills_db

# Security — เปลี่ยน JWT_SECRET เป็นค่าสุ่มยาว ๆ ทุกครั้งที่ติดตั้งจริง
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h

# Upload
UPLOAD_MAX_MB=10
